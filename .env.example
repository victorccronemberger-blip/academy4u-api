HOST=0.0.0.0
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://academy4u.com.br
PAYMENT_TENANTS=academy4u
ACADEMY4U_PUBLIC_ORIGIN=https://academy4u.com.br
ACADEMY4U_MYSQL_URL=
ACADEMY4U_TRUSTED_CHECKOUT_TOKEN=
ACADEMY4U_PAYMENT_REFERENCE_PREFIX=academy

# Galatic (loja física): o adapter de banco já está implementado. Para ativar,
# inclua o tenant e preencha as variáveis abaixo:
# PAYMENT_TENANTS=academy4u,galatic
# GALATIC_PUBLIC_ORIGIN=https://galatic.com.br
# GALATIC_MYSQL_URL=
# GALATIC_TRUSTED_CHECKOUT_TOKEN=
# GALATIC_PAYMENT_REFERENCE_PREFIX=galatic
# GALATIC_ENVIA_API_KEY=
# Remetente/origem das cotações de frete (conjunto completo obrigatório;
# sem ele POST /v1/galatic/quote responde 503):
# GALATIC_SHIPPING_NAME=
# GALATIC_SHIPPING_EMAIL=
# GALATIC_SHIPPING_PHONE=
# GALATIC_SHIPPING_STREET=
# GALATIC_SHIPPING_NUMBER=
# GALATIC_SHIPPING_DISTRICT=
# GALATIC_SHIPPING_CITY=
# GALATIC_SHIPPING_STATE=
# GALATIC_SHIPPING_POSTAL_CODE=
# GALATIC_SHIPPING_TAX_ID=
# E-mails transacionais da conta, recuperação e pedidos:
# GALATIC_SMTP_HOST=smtp.hostinger.com
# GALATIC_SMTP_PORT=465
# GALATIC_SMTP_SECURE=true
# GALATIC_SMTP_USER=
# GALATIC_SMTP_PASSWORD=
# GALATIC_MAIL_FROM=
# GALATIC_MAIL_FROM_NAME=Galatic
# Compatibilidade com a primeira implantação: ACADEMY4U_ORIGIN pode ser
# usado no lugar de PUBLIC_ORIGIN.
# Obtain all values below from the deployment secret manager; do not commit real values.
MYSQL_URL=
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
# Chave usada somente quando ASAAS_ENVIRONMENT=sandbox.
ASAAS_SANDBOX=
# Chave usada quando ASAAS_ENVIRONMENT=production.
ASAAS_API_KEY=
# Strong random token, 32-255 characters, also configured in the Asaas webhook.
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
# Shared secret with the LMS frontend (academy4u.com.br). Required header
# x-academy-trusted-token on POST /v1/checkout/orders (server-to-server only).
TRUSTED_CHECKOUT_TOKEN=
# Compatibilidade: ACADEMY4U_TRUSTED_CHECKOUT_TOKEN pode ser usado no lugar da
# variável acima.
