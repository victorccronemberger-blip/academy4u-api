HOST=0.0.0.0
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://academy4u.com.br
PAYMENT_TENANTS=academy4u
ACADEMY4U_PUBLIC_ORIGIN=https://academy4u.com.br
ACADEMY4U_MYSQL_URL=
ACADEMY4U_TRUSTED_CHECKOUT_TOKEN=
ACADEMY4U_PAYMENT_REFERENCE_PREFIX=academy

# Galatic (loja física): o adapter de banco já está implementado. Para ativar,
# inclua o tenant e preencha as variáveis abaixo:
# PAYMENT_TENANTS=academy4u,galatic
# GALATIC_PUBLIC_ORIGIN=https://galatic.com.br
# GALATIC_MYSQL_URL=
# GALATIC_TRUSTED_CHECKOUT_TOKEN=
# GALATIC_PAYMENT_REFERENCE_PREFIX=galatic
# GALATIC_ENVIA_API_KEY=
# GALATIC_ENVIA_ENVIRONMENT=sandbox
# Assinatura HMAC dos webhooks Envia (preferido). Use um segredo exclusivo por ambiente.
# GALATIC_ENVIA_WEBHOOK_SECRET=
# Alternativa quando o painel Envia oferece apenas Authorization Bearer.
# GALATIC_ENVIA_WEBHOOK_TOKEN=
# GALATIC_PAYMENT_MAINTENANCE_ENABLED=true
# GALATIC_PIX_RESERVATION_MINUTES=60
# GALATIC_CARD_RESERVATION_MINUTES=4320
# Remetente/origem das cotações de frete (conjunto completo obrigatório;
# sem ele POST /v1/galatic/quote responde 503):
# GALATIC_SHIPPING_NAME=
# GALATIC_SHIPPING_EMAIL=
# GALATIC_SHIPPING_PHONE=
# GALATIC_SHIPPING_STREET=
# GALATIC_SHIPPING_NUMBER=
# GALATIC_SHIPPING_DISTRICT=
# GALATIC_SHIPPING_CITY=
# GALATIC_SHIPPING_STATE=
# GALATIC_SHIPPING_POSTAL_CODE=
# GALATIC_SHIPPING_TAX_ID=
# E-mails transacionais da conta, recuperação e pedidos:
# GALATIC_SMTP_HOST=smtp.hostinger.com
# GALATIC_SMTP_PORT=465
# GALATIC_SMTP_SECURE=true
# GALATIC_SMTP_USER=
# GALATIC_SMTP_PASSWORD=
# Preferencial: Hostinger Agentic Mail REST API (SMTP fica como contingência)
# GALATIC_MAIL_API_ORIGIN=https://api.mail.hostinger.com
# GALATIC_MAIL_API_TOKEN=
# GALATIC_MAIL_API_MAILBOX_ID=
# GALATIC_MAIL_FROM=noreply@galatic.com.br
# GALATIC_MAIL_FROM_NAME=Galatic
# GALATIC_MAIL_FROM=
# GALATIC_MAIL_FROM_NAME=Galatic
# Credencial inicial do painel existente. Na primeira autenticação, a senha é
# convertida para scrypt no MySQL; nunca coloque estes valores no frontend:
# GALATIC_ADMIN_EMAIL=
# GALATIC_ADMIN_PASSWORD=
# Compatibilidade com a primeira implantação: ACADEMY4U_ORIGIN pode ser
# usado no lugar de PUBLIC_ORIGIN.
# Obtain all values below from the deployment secret manager; do not commit real values.
MYSQL_URL=
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
# Chave usada somente quando ASAAS_ENVIRONMENT=sandbox.
ASAAS_SANDBOX=
# Chave usada quando ASAAS_ENVIRONMENT=production.
ASAAS_API_KEY=
# Strong random token, 32-255 characters, also configured in the Asaas webhook.
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
# Shared secret with the LMS frontend (academy4u.com.br). Required header
# x-academy-trusted-token on POST /v1/checkout/orders (server-to-server only).
TRUSTED_CHECKOUT_TOKEN=
# Compatibilidade: ACADEMY4U_TRUSTED_CHECKOUT_TOKEN pode ser usado no lugar da
# variável acima.

# ---------------------------------------------------------------------------
# Integração ART (matrícula principal com fallback LMS).
# ART_ENABLED=true ativa a ativação automática de matrículas na plataforma ART
# quando um pedido é pago. Sem mapping (academy_art_mappings) ou em falha, o
# sistema cai automaticamente para a matrícula LMS local (comportamento atual).
# A conta ART é provisionada por aluno (email + CPF do destinatário do pedido).
# ---------------------------------------------------------------------------
ART_ENABLED=false
# Origens (defaults = plataforma ART de produção; só altere se necessário)
# ART_API_ORIGIN=https://api.academiarafaeltoro.com.br
# ART_IDM_ORIGIN=https://ms-idm.academiarafaeltoro.com.br
# Chave pública RSA para o x-api-key do checkout (default embutido no código)
# ART_PUBLIC_KEY=
# IP fictício registrado nos payloads (TEST-NET — nunca o IP do servidor)
# ART_FAKE_IP=203.0.113.50
# Timeout por request (ms) e delays do fluxo (ms) — defaults validados
# ART_REQUEST_TIMEOUT_MS=8000
# ART_PROVISION_POLL_MS=4000
# ART_PHASE2_WAIT_MS=5000
# ART_LOGIN_POLL_MS=3000
# ART_VERIFY_WAIT_MS=25000
# Worker de retry (converte pendências quando a senha ART reverte para o CPF)
# ART_RETRY_INTERVAL_MS=300000
# ART_RETRY_MAX_TRIES=8
# Piso da varredura de orders ART (o topo é descoberto dinamicamente; suba
# este valor se um dia a tabela já estiver muito acima — só afeta a 1ª sonda)
# ART_SCAN_FLOOR=3180000
